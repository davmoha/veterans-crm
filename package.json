{
  "name": "veterans-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development tsx index.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down",
    "build:image": "docker build -t veterans-crm ."
  },
  "dependencies": {
    "@tanstack/react-query": "^5.85.5",
    "@trpc/client": "^11.4.4",
    "@trpc/react-query": "^11.4.4",
    "@trpc/server": "^11.4.4",
    "cookie": "^1.0.2",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.44.4",
    "express": "^4.21.2",
    "lucide-react": "^0.539.0",
    "mysql2": "^3.14.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.3.7",
    "wouter": "^3.7.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/express": "^5.0.3",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
